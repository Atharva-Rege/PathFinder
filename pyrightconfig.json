{
  "include": [
    "*.py",
    "backend/**/*.py"
  ],
  "exclude": [
    "**/__pycache__",
    "**/node_modules",
    "**/.venv",
    "**/venv",
    "backend/venv",
    "frontend"
  ],
  "executionEnvironments": [
    {
      "root": "backend",
      "venvPath": "backend",
      "venv": "venv",
      "extraPaths": [
        "backend",
        "backend/venv/lib/python3.12/site-packages"
      ]
    },
    {
      "root": ".",
      "venvPath": ".",
      "venv": ".venv",
      "extraPaths": [
        ".",
        ".venv/lib/python3.12/site-packages"
      ]
    }
  ]
}
